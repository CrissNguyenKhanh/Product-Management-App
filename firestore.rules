rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function hasExactLecturerFields(data) {
      return data.keys().hasAll(['IDGV', 'Fullname', 'Image', 'SumClass'])
        && data.keys().hasOnly(['IDGV', 'Fullname', 'Image', 'SumClass']);
    }

    function isValidLecturer(data) {
      return hasExactLecturerFields(data)
        && data.IDGV is string
        && data.IDGV.size() >= 2
        && data.IDGV.size() <= 20
        && data.Fullname is string
        && data.Fullname.size() >= 2
        && data.Fullname.size() <= 100
        && data.Image is string
        && data.Image.size() <= 180000
        && (data.Image == ''
          || data.Image.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]*={0,2}$'))
        && data.SumClass is int
        && data.SumClass >= 0
        && data.SumClass <= 10000;
    }

    match /GiangVien/{documentId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && isValidLecturer(request.resource.data);
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
