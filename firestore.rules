rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function hasExactUserFields(data) {
      return data.keys().hasAll(['username', 'email', 'password', 'image'])
        && data.keys().hasOnly(['username', 'email', 'password', 'image']);
    }

    function isValidUser(data) {
      return hasExactUserFields(data)
        && data.username is string
        && data.username.size() >= 2
        && data.username.size() <= 50
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.password is string
        && data.password == '[demo-no-login]'
        && data.image is string
        && data.image.size() <= 180000
        && (data.image == ''
          || data.image.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]*={0,2}$'));
    }

    match /users/{documentId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && isValidUser(request.resource.data);
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
